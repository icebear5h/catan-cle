{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catan-learning.local/schemas/board_recognition/ms_swift_semantic_v1.schema.json",
  "title": "Semantic ms-swift board-recognition row",
  "type": "object",
  "additionalProperties": false,
  "required": ["messages", "images"],
  "properties": {
    "messages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "content"],
          "properties": {
            "role": {"const": "user"},
            "content": {
              "type": "string",
              "pattern": "^<image>\\n<(T[0-9]{2}|N[0-9]{2}|E[0-9]{2}_[0-9]{2}|P[0-9]{2})> (resource\\?|number\\?|robber here\\?|building\\?|road\\?|port\\?)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "content"],
          "properties": {
            "role": {"const": "assistant"},
            "content": {
              "type": "string",
              "pattern": "^[a-z0-9:]+( [a-z0-9:]+){0,2}$"
            }
          }
        }
      ]
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {"type": "string", "pattern": "^[^/]+\\.png$"}
      ]
    }
  }
}
