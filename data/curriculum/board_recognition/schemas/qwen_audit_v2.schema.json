{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catan-learning.local/schemas/board_recognition/qwen_audit_v2.schema.json",
  "title": "Atomic Qwen board-recognition audit row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "query_id", "state_id", "split", "epoch", "image_name",
    "image_sha256", "label_path", "source_kind", "game_id", "trajectory_id",
    "density_bin", "entity_type", "entity_type_id", "attribute", "attribute_id",
    "head", "slot", "slot_index", "class_name", "class_index", "query_token",
    "answer_token", "prompt_sha256"
  ],
  "properties": {
    "schema": {"const": "catan_board_recognition_qwen_audit/v2"},
    "query_id": {"type": "string", "pattern": "^.+_e[0-9]{3}_q[0-9]{3}$"},
    "state_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation", "test", "color_diagnostic"]},
    "epoch": {"type": "integer", "minimum": 0},
    "image_name": {"type": "string", "pattern": "^[^/]+\\.png$"},
    "image_sha256": {"$ref": "#/$defs/sha256"},
    "label_path": {"type": "string", "pattern": "^dense_labels/.+\\.json$"},
    "source_kind": {"enum": ["colonist_replay", "engine_rollout"]},
    "game_id": {"type": ["string", "null"]},
    "trajectory_id": {"type": "string", "minLength": 1},
    "density_bin": {"enum": ["empty", "setup", "sparse", "dense"]},
    "entity_type": {"enum": ["tile", "node", "edge", "port"]},
    "entity_type_id": {"type": "integer", "minimum": 0, "maximum": 3},
    "attribute": {"enum": ["resource", "number", "robber", "occupancy", "owner", "port_type"]},
    "attribute_id": {"type": "integer", "minimum": 0, "maximum": 5},
    "head": {"enum": ["tile.resource", "tile.number", "tile.robber", "node.occupancy", "edge.owner", "port.port_type"]},
    "slot": {"type": "string", "pattern": "^<(T|N|E|P)[0-9_]+>$"},
    "slot_index": {"type": "integer", "minimum": 0, "maximum": 71},
    "class_name": {"type": "string", "minLength": 1},
    "class_index": {"type": "integer", "minimum": 0, "maximum": 22},
    "query_token": {"type": "string", "pattern": "^<Q_[A-Z_]+>$"},
    "answer_token": {"type": "string", "pattern": "^<A_[A-Z0-9_]+>$"},
    "prompt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
