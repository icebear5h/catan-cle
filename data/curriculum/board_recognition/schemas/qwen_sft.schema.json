{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catan-learning.local/schemas/board_recognition/qwen_sft.schema.json",
  "title": "Qwen board-recognition SFT row",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "conversations"],
  "properties": {
    "image": {
      "type": "string",
      "pattern": "^images/.+\\.png$"
    },
    "conversations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "value"],
          "properties": {
            "from": {"const": "human"},
            "value": {
              "type": "string",
              "pattern": "^<image>\\n",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "value"],
          "properties": {
            "from": {"const": "gpt"},
            "value": {
              "type": "string",
              "minLength": 1,
              "not": {"pattern": "<image>"}
            }
          }
        }
      ]
    }
  }
}
